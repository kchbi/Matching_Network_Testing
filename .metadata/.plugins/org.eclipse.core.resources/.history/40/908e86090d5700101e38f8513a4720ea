#include "uart_handler.h"
#include <string.h> // For memset
#include <stdio.h>  // For printf redirection

/* --- Private Module Variables --- */
static UART_HandleTypeDef *g_huart;
#define RX_BUFFER_SIZE 64
static volatile uint8_t g_uart_rx_byte = 0;
static volatile uint8_t g_rx_buffer[RX_BUFFER_SIZE];
static volatile uint8_t g_rx_index = 0;
static volatile uint8_t g_command_received_flag = 1;



/* --- Public Function Implementations --- */

void uart_handler_init(UART_HandleTypeDef *huart) {
    g_huart = huart; // Store the UART handle
    // Start the UART receive interrupt
    HAL_UART_Receive_IT(g_huart, (uint8_t*)&g_uart_rx_byte, 1);
}

uint8_t uart_command_is_ready(void) {
    return g_command_received_flag;
}

const uint8_t* uart_get_command_buffer(void) {
    return g_rx_buffer;
}

void uart_reset_for_next_command(void) {
    g_command_received_flag = 0;
    g_rx_index = 0;
    memset((void*)g_rx_buffer, 0, RX_BUFFER_SIZE);
}

/* --- Interrupt and System Call Implementations (Moved from main.c) --- */

void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart) {
    if (huart->Instance == g_huart->Instance) {
        if (g_uart_rx_byte == '\n' || g_uart_rx_byte == '\r') {
            if (g_rx_index > 0) {
                g_rx_buffer[g_rx_index] = '\0';
                g_command_received_flag = 1;
            }
        } else {
            if (g_rx_index < RX_BUFFER_SIZE - 1) {
                g_rx_buffer[g_rx_index++] = g_uart_rx_byte;
            }
        }
        HAL_UART_Receive_IT(g_huart, (uint8_t*)&g_uart_rx_byte, 1);
    }
}

#ifdef __GNUC__
#define PUTCHAR_PROTOTYPE int __io_putchar(int ch)
#else
#define PUTCHAR_PROTOTYPE int fputc(int ch, FILE *f)
#endif

PUTCHAR_PROTOTYPE {
  HAL_UART_Transmit(g_huart, (uint8_t *)&ch, 1, HAL_MAX_DELAY);
  return ch;
}

