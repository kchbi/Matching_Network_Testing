#include "I2ccomm.h"
#include <stdio.h>
#include <string.h>

uint32_t Timeout = 100 ;
#define FirstDeviceAddress  0x40
#define ConfigAddress 0x00
uint16_t ConfigSettings = 0x4527 ;
HAL_StatusTypeDef I2C_Init(I2C_HandleTypeDef *hi2c, uint16_t DevAddress, float shunt_resistor_ohm)
{
	if(HAL_I2C_IsDeviceReady(hi2c, ((DevAddress) << 1) +0 , 10,  Timeout) != HAL_OK)
	{
		printf("The I2C Device is not Ready \n");
		return HAL_ERROR;
	}
	printf("The Device is Ready \n");
	if(HAL_I2C_Mem_Write(hi2c, ((DevAddress) << 1) +0, ConfigAddress , I2C_MEMADD_SIZE_16BIT, &ConfigSettings, 1, Timeout) != HAL_OK)
	{
		printf("The I2C Device is not Ready \n");
		return HAL_ERROR;
	}
	printf("The Device is Ready \n");


	return HAL_OK;

}

