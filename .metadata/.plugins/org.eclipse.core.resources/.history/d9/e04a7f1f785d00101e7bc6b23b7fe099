        if (HAL_GetTick() - timeout_start > MOVE_TIMEOUT_MS) { // <<< CHANGED
            motor1_set_state(MOTOR_STOP, MOTOR_SPEED);
            return;
        }
        HAL_Delay(LOOP_DELAY_MS); // <<< CHANGED
    }
}

